# Safe defaults for the Docker Compose demo. Do not put API keys in this file.
EMS_PROVIDER_MODE=deterministic-fixtures
EMS_SERVICE_TOKEN=local-ems-service-token
EMS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Optional: set these only when using the API outside Docker.
# EMS_PERSISTENCE_MODE=postgres
# DATABASE_URL=postgresql+asyncpg://ems:ems@127.0.0.1:5432/ems
